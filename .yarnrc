# Supply-chain hardening: never run dependency lifecycle scripts
# (preinstall/install/postinstall) during yarn install.
# Note: releases are unaffected — they run `npm publish` (via the shared
# npm-release template), and npm reads .npmrc, not this file, so prepack
# still builds at publish time. Do NOT publish locally with `yarn publish`
# or `yarn pack` — yarn classic applies this flag there too and would produce
# a tarball without build output; use `npm publish` / `npm pack` instead.
ignore-scripts true
