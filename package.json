{
  "name": "@unleash/unleash-react-native-sdk",
  "version": "1.0.1",
  "description": "A React Native / Expo SDK for Unleash",
  "repository": {
    "type": "git",
    "url": "https://github.com/Unleash/unleash-react-native-sdk.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "module": "dist/unleash-react-native.js",
  "react-native": "dist/unleash-react-native.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/unleash-react-native.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "unleash",
    "react-native",
    "expo",
    "feature-flags"
  ],
  "files": [
    "dist",
    "LICENSE.txt"
  ],
  "scripts": {
    "build": "tsc && vite build",
    "prepack": "yarn run build",
    "test": "vitest --watch",
    "test:ci": "CI=true vitest run"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.29",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.9.3",
    "unleash-proxy-client": "^3.8.0",
    "vite": "^8.0.14",
    "vite-plugin-dts": "^5.0.1",
    "vitest": "^4.1.7"
  },
  "peerDependencies": {
    "@types/react": "^18.2.38 || ^19.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "unleash-proxy-client": "^3.8.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@unleash/proxy-client-react": "^5.0.0",
    "react-native-get-random-values": "^2.0.0"
  }
}
